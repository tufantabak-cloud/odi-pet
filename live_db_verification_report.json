  "policies": [
    {
      "tablename": "article_pet_states",
      "policyname": "Users can delete own pet article states",
      "roles": [
        "public"
      ],
      "cmd": "DELETE",
      "qual": "((auth.uid() = user_id) AND ((EXISTS ( SELECT 1\n   FROM pets\n  WHERE ((pets.id = article_pet_states.pet_id) AND (pets.owner_id = auth.uid())))) OR (EXISTS ( SELECT 1\n   FROM pet_owners\n  WHERE ((pet_owners.pet_id = article_pet_states.pet_id) AND (pet_owners.profile_id = auth.uid()))))))"
    },
    {
      "tablename": "article_pet_states",
      "policyname": "Users can insert own pet article states",
      "roles": [
        "public"
      ],
      "cmd": "INSERT",
      "qual": null
    },
    {
      "tablename": "article_pet_states",
      "policyname": "Users can update own pet article states",
      "roles": [
        "public"
      ],
      "cmd": "UPDATE",
      "qual": "((auth.uid() = user_id) AND ((EXISTS ( SELECT 1\n   FROM pets\n  WHERE ((pets.id = article_pet_states.pet_id) AND (pets.owner_id = auth.uid())))) OR (EXISTS ( SELECT 1\n   FROM pet_owners\n  WHERE ((pet_owners.pet_id = article_pet_states.pet_id) AND (pet_owners.profile_id = auth.uid()))))))"
    },
    {
      "tablename": "article_pet_states",
      "policyname": "Users can view own pet article states",
      "roles": [
        "public"
      ],
      "cmd": "SELECT",
      "qual": "((auth.uid() = user_id) AND ((EXISTS ( SELECT 1\n   FROM pets\n  WHERE ((pets.id = article_pet_states.pet_id) AND (pets.owner_id = auth.uid())))) OR (EXISTS ( SELECT 1\n   FROM pet_owners\n  WHERE ((pet_owners.pet_id = article_pet_states.pet_id) AND (pet_owners.profile_id = auth.uid()))))))"
    },
    {
      "tablename": "articles",
      "policyname": "Admin and founder can manage articles",
      "roles": [
        "public"
      ],
      "cmd": "ALL",
      "qual": "(EXISTS ( SELECT 1\n   FROM profiles\n  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['admin'::user_role, 'founder'::user_role])))))"
    },
    {
      "tablename": "articles",
      "policyname": "Anyone can read eligible published articles",
      "roles": [
        "public"
      ],
      "cmd": "SELECT",
      "qual": "(((is_published = true) AND ((is_medical_content = false) OR (vet_review_status = 'approved'::text))) OR (EXISTS ( SELECT 1\n   FROM profiles\n  WHERE ((profiles.id = auth.uid()) AND (profiles.role = ANY (ARRAY['admin'::user_role, 'founder'::user_role]))))))"
    }
  ]
