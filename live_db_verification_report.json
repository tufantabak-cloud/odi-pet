  "constraints": [
    {
      "table_name": "articles",
      "conname": "articles_neutered_status_check",
      "definition": "CHECK ((target_neutered_status = ANY (ARRAY['all'::text, 'neutered'::text, 'intact'::text])))"
    },
    {
      "table_name": "articles",
      "conname": "articles_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "articles",
      "conname": "articles_slug_key",
      "definition": "UNIQUE (slug)"
    },
    {
      "table_name": "articles",
      "conname": "articles_vet_review_status_check",
      "definition": "CHECK ((vet_review_status = ANY (ARRAY['not_required'::text, 'pending'::text, 'approved'::text])))"
    },
    {
      "table_name": "articles",
      "conname": "articles_vet_reviewed_by_fkey",
      "definition": "FOREIGN KEY (vet_reviewed_by) REFERENCES profiles(id)"
    },
    {
